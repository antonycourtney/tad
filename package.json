{
  "name": "tad-monorepo",
  "private": true,
  "version": "0.14.0",
  "description": "Monorepo for Tabular data viewer libraries and apps",
  "workspaces": [
    "packages/reltab",
    "packages/aggtree",
    "packages/reltab-sqlite",
    "packages/reltab-duckdb",
    "packages/reltab-fs",
    "packages/reltab-aws-athena",
    "packages/reltab-bigquery",
    "packages/reltab-snowflake",
    "packages/tadviewer",
    "packages/tadweb-app",
    "packages/tadweb-server",
    "packages/tad-app"
  ],
  "overrides": {
    "ws": "8.18.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "lerna": "^4.0.0",
    "rimraf": "^5.0.5",
    "run-script-os": "^1.1.6",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node tools/buildAll.js",
    "test": "npm test -w reltab -w aggtree -w reltab-sqlite -w tadviewer && npm run test:run -w reltab-duckdb"
  }
}
